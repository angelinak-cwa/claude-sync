{
  "description": "Синхронизация Claude Code и Orca между компьютерами: подтягивает при старте сессии, проверяет свежесть чата перед каждым сообщением, отправляет после каждого ответа и при закрытии сессии.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ccsync.sh\" start",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ccsync.sh\" prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ccsync.sh\" stop",
            "async": true,
            "timeout": 180
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ccsync.sh\" end",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
